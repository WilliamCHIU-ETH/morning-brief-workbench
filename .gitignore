node_modules/

# gate runner 的產出，每次執行都會重寫
gate-report.json

# 各階段在 project 目錄裡的產物（fixtures 裡的輸入檔要進版控，產物不要）
# fixtures 的 sidecar 要進版控（gate 會檢查它們存在）；只忽略非 fixtures 的
/*/**/*.provenance.json
!fixtures/**/*.provenance.json

# agent 的工作目錄
projects/

# ASR 模型 57MB，用 npm run setup:whisper 下載
.cache/

# 金鑰。每個 repo 各自持有一份，不進版控
.env

# 對標影片的本機素材（mp4、逐秒定格、轉錄）：有版權、也重，只留在本機。
# 蒸餾出來的規則在 docs/editing-techniques.md 與 docs/reference-reels.md，那兩份進版控。
docs/reference-reels/local/

# 本機 launch 設定（指向使用者機器上的其他專案），不進版控
.claude/launch.json
